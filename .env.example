# Discord Developer Portal 建立的 Bot Token
DISCORD_TOKEN=
# 接收 new_available、available、restocked 上架通知的文字頻道 ID
DISCORD_CHANNEL_ID=
# 接收其他商品事件、啟動、錯誤與恢復通知的文字頻道 ID
DISCORD_OTHER_CHANNEL_ID=1538802130196889700
# 選填：有「可購買／補貨」時標註的身分組 ID
DISCORD_ROLE_MENTION_ID=

# 誠品「對戰遊戲」策展
ESLITE_EXHIBIT_ID=CU202310-00113
ESLITE_API_URL=https://athena.eslite.com/api/v1/book_exhibits/CU202310-00113
ESLITE_PAGE_URL=https://www.eslite.com/exhibitions/CU202310-00113

# 以逗號分隔；留空表示監控策展中的全部商品
KEYWORDS=BEYBLADE,戰鬥陀螺
# 建議不要低於 30 秒，程式最低允許 15 秒
POLL_INTERVAL_SECONDS=60
REQUEST_TIMEOUT_MS=30000
MAX_CONSECUTIVE_FAILURES=3
STATE_FILE=.data/state.json

# browser：啟動後直接使用本機瀏覽器讀取 API；http 僅供手動診斷
# 可選 http、browser
ESLITE_FETCH_MODE=browser
# Windows 內建 Edge 通常可直接使用；也可改成 chrome
BROWSER_CHANNEL=msedge
# 若無法由 channel 找到瀏覽器，可填瀏覽器執行檔的絕對路徑
BROWSER_EXECUTABLE_PATH=
# 目前誠品會擋無頭瀏覽器；false 會開啟並保留一個 Edge/Chrome 視窗
BROWSER_HEADLESS=false

# 第一次執行預設只建立基準資料，不把現有商品全部當成新上架
NOTIFY_ON_FIRST_RUN=false
NOTIFY_STARTUP=true

# 選填：誠品日後若要求額外標頭，可填 JSON；請勿提交含敏感資料的 .env
ESLITE_EXTRA_HEADERS_JSON={}

# Funbox 戰鬥陀螺分類；此來源可直接讀取 JSON，不會增加瀏覽器視窗
FUNBOX_ENABLED=true
FUNBOX_BASE_URL=https://shop.funbox.com.tw
FUNBOX_CATEGORY_PATH=XI/KB
FUNBOX_PAGE_SIZE=100
FUNBOX_MAX_PAGES=20
FUNBOX_REQUEST_TIMEOUT_MS=30000
FUNBOX_STATE_FILE=.data/funbox-state.json

# momo購物網 Funbox Toys 館「戰鬥陀螺」分類；直接使用網頁前端 JSON API
MOMO_ENABLED=true
MOMO_BASE_URL=https://www.momoshop.com.tw
MOMO_CATEGORY_ID=2186500036
MOMO_PAGE_URL=https://www.momoshop.com.tw/categories/2186500036
MOMO_API_URL=https://www.momoshop.com.tw/api/moecapp/getCategoryGoodsV3
MOMO_API_VERSION=2608.1.6
MOMO_CATE_LEVEL=3
MOMO_PAGE_SIZE=80
MOMO_MAX_PAGES=10
MOMO_REQUEST_TIMEOUT_MS=30000
MOMO_BACKOFF_SECONDS=600
MOMO_POLL_INTERVAL_SECONDS=60
MOMO_STATE_FILE=.data/momo-state.json
