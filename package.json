{
  "name": "eslite-beyblade-discord-monitor",
  "version": "1.0.0",
  "private": true,
  "description": "Monitor Eslite exhibition JSON changes and notify Discord.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test",
    "check": "node --check src/index.js",
    "check:eslite": "node scripts/check-eslite.js",
    "check:funbox": "node scripts/check-funbox.js",
    "check:momo": "node scripts/check-momo.js"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "playwright-core": "^1.61.1"
  }
}
